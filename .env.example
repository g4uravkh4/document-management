DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=https://your-app.vercel.app

# Use local for development. Use s3 in production.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Required when STORAGE_DRIVER=s3. These work with Supabase Storage, R2,
# MinIO, or another S3-compatible provider.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Leave SMTP_HOST empty locally to log verification codes to the API console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password# API
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ca_firm?schema=public"

# Auth (generate strong random values in production)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# File uploads
UPLOAD_DIR=uploads

# Mail (SMTP). Leave empty to fall back to logging codes to the server console
# and returning them as `devCode` in API responses (for local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@cafirm.local
